<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks for the shared logic (FishBowl.Core.cs and FishBowl.Platform.cs) on Linux. See README, Building from source. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CA1416;SYSLIB0014</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../FishBowl.Core.cs" Link="Shared/FishBowl.Core.cs" />
    <Compile Include="../../FishBowl.Platform.cs" Link="Shared/FishBowl.Platform.cs" />
    <Compile Include="../../FishBowl.Model.cs" Link="Shared/FishBowl.Model.cs" />
    <Compile Include="../../FishBowl.GameRecognition.cs" Link="Shared/FishBowl.GameRecognition.cs" />
    <Compile Include="../../FishBowl.LinuxShims.cs" Link="Shared/FishBowl.LinuxShims.cs" />
    <Compile Include="CoreTests.cs" />
    <Compile Include="../../FishBowl.Library.cs" Link="Shared/FishBowl.Library.cs" />
    <Compile Include="../../FishBowl.Games.cs" Link="Shared/FishBowl.Games.cs" />
    <Compile Include="RecognitionTests.cs" />
      <Compile Include="../../FishBowl.GameTools.cs" Link="Shared/FishBowl.GameTools.cs" />
    <Compile Include="../../FishBowl.Integrations.cs" Link="Shared/FishBowl.Integrations.cs" />
      <Compile Include="../../FishBowl.SaveTools.cs" Link="Shared/FishBowl.SaveTools.cs" />
    <Compile Include="SaveHistoryTests.cs" />
    <Compile Include="SaveMonitorTests.cs" />
      <Compile Include="../../FishBowl.Sessions.cs" Link="Shared/FishBowl.Sessions.cs" />
      <Compile Include="../../FishBowl.LivingRoom.cs" Link="Shared/FishBowl.LivingRoom.cs" />
      <Compile Include="LivingRoomTests.cs" />
    <Compile Include="../../FishBowl.Avalonia/LinuxJoystick.cs" Link="Platform/LinuxJoystick.cs" />
    <Compile Include="ControllerInputTests.cs" />
    <Compile Include="SessionTests.cs" />
    <Compile Include="GamesTests.cs" />
    <Compile Include="../../FishBowl.Profiles.cs" Link="Shared/FishBowl.Profiles.cs" />
    <Compile Include="ProfilesTests.cs" />
    <Compile Include="LaunchOptionsTests.cs" />
  </ItemGroup>
</Project>
